# Genetic Mastery on WEDOS webhosting. Copy to .env next to artisan and fill in.
# Generate APP_KEY locally: php artisan key:generate --show

APP_NAME="Genetic Mastery"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://genetic.example.cz

APP_LOCALE=cs
APP_FALLBACK_LOCALE=cs
APP_DISPLAY_TIMEZONE=Europe/Prague
CLUSTER_NAME=

# WEDOS passes requests through its own proxies.
TRUSTED_PROXIES=*

# JSON lines in storage/logs/genetic-YYYY-MM-DD.jsonl (there is no stderr collector).
LOG_CHANNEL=json_file
LOG_LEVEL=info

# --- Database ------------------------------------------------------------------
# Recommended on webhosting: MariaDB from the WEDOS administration
# (Databáze → MariaDB). Host, name and user are shown there.
DB_CONNECTION=mariadb
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# SQLite alternative (only if you accept the risk of network storage):
# DB_CONNECTION=sqlite
# DB_DATABASE=storage/database/database.sqlite
# DB_JOURNAL_MODE=delete
# DB_SYNCHRONOUS=full

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# --- Discord -------------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI="${APP_URL}/auth/discord/callback"
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
DISCORD_ANNOUNCE_CHANNEL_ID=
# Announcements go out with the cron: every hour on basic WEDOS webhosting,
# every 5 minutes with the CRON+ add-on (recommended). true sends them right
# after the admin's decision (after the response, the cron retries failures);
# that departs from the rule "never from the request", so it is off by default.
DISCORD_SEND_AFTER_RESPONSE=false

# --- Permissions ---------------------------------------------------------------
ADMIN_ROLE_IDS=
ADMIN_USER_IDS=
ALLOW_SELF_APPROVE=false

# --- Rules ---------------------------------------------------------------------
UPLOAD_MAX_MB=15
UPLOAD_MAX_FILES=10
UPLOAD_MAX_TOTAL_MB=60
INDO_BASE=150
INDO_PER_MILESTONE=25

# --- Operations ----------------------------------------------------------------
# Long random strings (at least 32 characters), e.g. php -r "echo bin2hex(random_bytes(24));"
# CRON_TOKEN: the WEDOS cron calls https://<web>/ops/cron/<CRON_TOKEN>
CRON_TOKEN=
# DEPLOY_TOKEN: /ops/deploy/{check|migrate|optimize|clear|discord-commands}/<DEPLOY_TOKEN>
# Fill in while deploying, empty it afterwards.
DEPLOY_TOKEN=

BACKUP_ENABLED=true
BACKUP_DISK=local
BACKUP_PATH=backups
BACKUP_EVERY_HOURS=24
BACKUP_RETENTION_DAYS=30
