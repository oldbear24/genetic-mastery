APP_NAME="Genetic Mastery"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=cs
APP_FALLBACK_LOCALE=cs
APP_FAKER_LOCALE=cs_CZ
APP_DISPLAY_TIMEZONE=Europe/Prague

APP_MAINTENANCE_DRIVER=file

# Shown under the logo as "<name> · ARK cluster"
CLUSTER_NAME=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite in WAL mode by default. For PostgreSQL set DB_CONNECTION=pgsql and the DB_* below.
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USERNAME=genetic
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Defaults to true when APP_ENV=production
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# --- Discord ---------------------------------------------------------------
# Application from https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI="${APP_URL}/auth/discord/callback"
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
DISCORD_ANNOUNCE_CHANNEL_ID=

# --- Permissions -------------------------------------------------------------
# Comma separated Discord role IDs and user IDs that make someone an admin.
ADMIN_ROLE_IDS=
ADMIN_USER_IDS=
ALLOW_SELF_APPROVE=false

# --- Rules -------------------------------------------------------------------
UPLOAD_MAX_MB=15
UPLOAD_MAX_FILES=10
UPLOAD_MAX_TOTAL_MB=60
INDO_BASE=150
INDO_PER_MILESTONE=25

# --- Operations --------------------------------------------------------------
# Behind a TLS-terminating proxy: TRUSTED_PROXIES=* (or comma separated IPs)
TRUSTED_PROXIES=
# Backups (daily 03:30): disk from config/filesystems.php, ideally off-site
BACKUP_DISK=local
BACKUP_PATH=backups
BACKUP_RETENTION_DAYS=30

VITE_APP_NAME="${APP_NAME}"
