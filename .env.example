APP_NAME="Genetic Mastery"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=cs
APP_FALLBACK_LOCALE=cs
APP_FAKER_LOCALE=cs_CZ
APP_DISPLAY_TIMEZONE=Europe/Prague

APP_MAINTENANCE_DRIVER=file

# Shown under the logo as "<name> · ARK cluster"
CLUSTER_NAME=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite in WAL mode by default (DB_DATABASE may be relative to the app root).
# MySQL / MariaDB: DB_CONNECTION=mysql or mariadb, PostgreSQL: pgsql, plus DB_HOST etc.
DB_CONNECTION=sqlite
# DB_DATABASE=storage/database/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=genetic
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Defaults to true when APP_ENV=production
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# --- Discord ---------------------------------------------------------------
# Application from https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI="${APP_URL}/auth/discord/callback"
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
DISCORD_ANNOUNCE_CHANNEL_ID=

# --- Permissions -------------------------------------------------------------
# Comma separated Discord role IDs and user IDs that make someone an admin.
ADMIN_ROLE_IDS=
ADMIN_USER_IDS=
ALLOW_SELF_APPROVE=false

# --- Rules -------------------------------------------------------------------
UPLOAD_MAX_MB=15
UPLOAD_MAX_FILES=10
UPLOAD_MAX_TOTAL_MB=60
INDO_BASE=150
INDO_PER_MILESTONE=25

# --- Operations --------------------------------------------------------------
# Behind a TLS-terminating proxy: TRUSTED_PROXIES=* (or comma separated IPs)
TRUSTED_PROXIES=
# Backups when the newest snapshot is older than BACKUP_EVERY_HOURS; disk from
# config/filesystems.php, ideally off-site
BACKUP_ENABLED=true
BACKUP_DISK=local
BACKUP_PATH=backups
BACKUP_EVERY_HOURS=24
BACKUP_RETENTION_DAYS=30
# Shared hosting without SSH (WEDOS): tokens of at least 32 characters for
# /ops/cron/{token} and /ops/deploy/{action}/{token}. Empty = endpoints off.
CRON_TOKEN=
DEPLOY_TOKEN=
# Send Discord messages right after the admin's response (cron retries failures).
DISCORD_SEND_AFTER_RESPONSE=false

VITE_APP_NAME="${APP_NAME}"
